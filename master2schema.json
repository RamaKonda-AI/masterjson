{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scene-studio.local/schemas/scene.schema.json",
  "title": "Scene Studio Scene Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meta",
    "output",
    "avatar",
    "scenes"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "author": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "format"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "multipleOf": 2,
          "default": 1080
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 3840,
          "multipleOf": 2,
          "default": 1920
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ],
          "default": 30
        },
        "format": {
          "const": "mp4"
        },
        "videoCodec": {
          "type": "string",
          "enum": [
            "libx264"
          ],
          "default": "libx264"
        },
        "quality": {
          "type": "integer",
          "minimum": 16,
          "maximum": 30,
          "default": 20
        },
        "preset": {
          "type": "string",
          "enum": [
            "ultrafast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow"
          ],
          "default": "medium"
        },
        "audioBitrate": {
          "type": "string",
          "pattern": "^[0-9]{2,3}k$",
          "default": "192k"
        },
        "profile": {
          "type": "string",
          "enum": [
            "custom",
            "youtube-shorts",
            "youtube-landscape",
            "youtube-4k-landscape",
            "instagram-reels",
            "instagram-feed-portrait",
            "instagram-square",
            "instagram-feed-landscape"
          ],
          "default": "custom"
        },
        "sampleRate": {
          "type": "integer",
          "enum": [
            44100,
            48000
          ],
          "default": 48000
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "filebin": {
              "enabled": true
            }
          },
          "properties": {
            "filebin": {
              "type": "object",
              "additionalProperties": false,
              "default": {
                "enabled": true
              },
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "binPrefix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "binName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-zA-Z0-9_-]+$"
                }
              }
            }
          }
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "gender",
        "hairstyle",
        "skinTone",
        "hairColor",
        "eyeColor",
        "glasses",
        "clothing"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "gender": {
          "type": "string",
          "enum": [
            "man",
            "woman",
            "androgynous"
          ],
          "default": "man"
        },
        "hairstyle": {
          "type": "string",
          "enum": [
            "short",
            "side-part",
            "curly",
            "long",
            "bob",
            "bun",
            "bald"
          ],
          "default": "short"
        },
        "faceShape": {
          "type": "string",
          "enum": [
            "oval",
            "round",
            "square"
          ],
          "default": "oval"
        },
        "eyeStyle": {
          "type": "string",
          "enum": [
            "almond",
            "round",
            "narrow"
          ],
          "default": "almond"
        },
        "hairColor": {
          "type": "string",
          "default": "#241914"
        },
        "hairHighlightColor": {
          "type": "string"
        },
        "hairShadowColor": {
          "type": "string"
        },
        "skinTone": {
          "type": "string",
          "default": "#d9a17c"
        },
        "eyeColor": {
          "type": "string",
          "default": "#302016"
        },
        "glasses": {
          "type": "string",
          "enum": [
            "none",
            "round",
            "rectangular"
          ],
          "default": "none"
        },
        "glassesColor": {
          "type": "string",
          "default": "#27364b"
        },
        "beard": {
          "type": "string",
          "enum": [
            "none",
            "stubble",
            "short",
            "full",
            "mustache"
          ],
          "default": "none"
        },
        "clothing": {
          "type": "string",
          "enum": [
            "shirt",
            "hoodie",
            "suit",
            "sweater",
            "blouse"
          ],
          "default": "shirt"
        },
        "clothingColor": {
          "type": "string",
          "default": "#315b8a"
        },
        "secondaryClothingColor": {
          "type": "string",
          "default": "#f5f7fb"
        },
        "defaultExpression": {
          "type": "string",
          "enum": [
            "neutral",
            "happy",
            "explaining",
            "thinking",
            "confused",
            "surprised",
            "sad",
            "angry"
          ],
          "default": "explaining"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "const": "bottom-right"
            },
            "size": {
              "type": "number",
              "minimum": 0.12,
              "maximum": 0.34,
              "default": 0.22
            },
            "padding": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 0.12,
              "default": 0.035
            }
          }
        },
        "accentColor": {
          "type": "string",
          "default": "#3b8eea"
        },
        "backgroundStart": {
          "type": "string",
          "default": "#eef6ff"
        },
        "backgroundEnd": {
          "type": "string",
          "default": "#9fb9d8"
        },
        "motionStyle": {
          "type": "string",
          "enum": [
            "still",
            "subtle",
            "lively"
          ],
          "default": "subtle"
        },
        "gestureStyle": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "presenter"
          ],
          "default": "presenter"
        },
        "earrings": {
          "type": "string",
          "enum": [
            "none",
            "stud",
            "hoop"
          ],
          "default": "none"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "audio": {
      "$ref": "#/definitions/globalAudio"
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "whiteboard",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "durationMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 300000
        },
        "background": {
          "type": "string",
          "default": "#f7f9fc"
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "cut",
                "fade",
                "crossfade",
                "wipe-left",
                "wipe-right",
                "wipe-up",
                "wipe-down",
                "zoom"
              ],
              "default": "fade"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "default": 450
            },
            "easing": {
              "type": "string",
              "enum": [
                "linear",
                "easeOutCubic",
                "easeInOutCubic",
                "easeOutQuart",
                "easeOutBack",
                "easeOutBounce",
                "easeOutElastic",
                "easeInOutSine",
                "easeOutQuint",
                "easeOutExpo"
              ],
              "default": "easeInOutCubic"
            }
          }
        },
        "whiteboard": {
          "$ref": "#/definitions/whiteboard"
        },
        "elements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/element"
          }
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "events": {
              "type": "array",
              "maxItems": 300,
              "items": {
                "$ref": "#/definitions/event"
              }
            }
          }
        },
        "audio": {
          "$ref": "#/definitions/audio"
        }
      }
    },
    "whiteboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "text",
            "full-image",
            "split"
          ],
          "default": "text"
        },
        "background": {
          "type": "string",
          "default": "#ffffff"
        },
        "grid": {
          "type": "boolean",
          "default": false
        },
        "gridColor": {
          "type": "string",
          "default": "#edf1f6"
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "fit": {
              "type": "string",
              "enum": [
                "cover",
                "contain"
              ]
            },
            "side": {
              "type": "string",
              "enum": [
                "right",
                "left",
                "top",
                "bottom"
              ],
              "default": "right"
            },
            "ratio": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 0.75,
              "default": 0.5
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1,
              "default": 0.025
            },
            "imageGeneration": {
              "$ref": "#/definitions/imageGeneration"
            }
          },
          "anyOf": [
            {
              "required": [
                "src"
              ]
            },
            {
              "required": [
                "imageGeneration"
              ]
            }
          ]
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "manual",
                "hybrid",
                "auto"
              ],
              "default": "hybrid"
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.16,
              "default": 0.045
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1,
              "default": 0.014
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "avoidOverlap": {
              "type": "boolean",
              "default": true
            },
            "avoidAvatar": {
              "type": "boolean",
              "default": true
            },
            "minCellHeight": {
              "type": "number",
              "minimum": 40,
              "maximum": 800
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "full-image",
                  "split"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "media"
            ]
          }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "card",
            "equation",
            "shape",
            "diagram",
            "drawing"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 8000
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "roundRect",
            "circle",
            "line",
            "arrow"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "fontFamily": {
          "type": "string",
          "default": "Lato, \"Noto Sans\", \"DejaVu Sans\", sans-serif"
        },
        "fontWeight": {
          "type": "string",
          "enum": [
            "400",
            "500",
            "600",
            "700",
            "800"
          ],
          "default": "700"
        },
        "fontSize": {
          "type": "number",
          "minimum": 10,
          "maximum": 180,
          "default": 54
        },
        "minFontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 100,
          "default": 22
        },
        "color": {
          "type": "string",
          "default": "#172033"
        },
        "fill": {
          "type": "string",
          "default": "#ffffff"
        },
        "stroke": {
          "type": "string",
          "default": "#d7deea"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 2
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 80,
          "default": 18
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "left"
        },
        "valign": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "default": "top"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ],
          "default": "contain"
        },
        "effect": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "zoom",
            "pop",
            "bounce",
            "flip",
            "spring",
            "swing",
            "typewriter"
          ],
          "default": "fade"
        },
        "effectDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 700
        },
        "bold": {
          "type": "boolean",
          "default": false
        },
        "easing": {
          "type": "string",
          "enum": [
            "linear",
            "easeOutCubic",
            "easeInOutCubic",
            "easeOutQuart",
            "easeOutBack",
            "easeOutBounce",
            "easeOutElastic",
            "easeInOutSine",
            "easeOutQuint",
            "easeOutExpo"
          ],
          "default": "easeOutCubic"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "manual",
                "auto"
              ]
            },
            "allowOverlap": {
              "type": "boolean",
              "default": false
            },
            "allowAvatarOverlap": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "diagram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "layout": {
              "type": "string",
              "enum": [
                "flow",
                "grid",
                "comparison",
                "mind-map"
              ],
              "default": "flow"
            },
            "direction": {
              "type": "string",
              "enum": [
                "auto",
                "horizontal",
                "vertical"
              ],
              "default": "auto"
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "gap": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 0.12,
              "default": 0.035
            },
            "connectors": {
              "type": "boolean",
              "default": true
            },
            "connectorColor": {
              "type": "string",
              "default": "#9aaec5"
            },
            "connectorWidth": {
              "type": "number",
              "minimum": 1,
              "maximum": 12,
              "default": 3
            },
            "staggerMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000,
              "default": 140
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 360
                  },
                  "fill": {
                    "type": "string"
                  },
                  "stroke": {
                    "type": "string"
                  },
                  "accent": {
                    "type": "string"
                  },
                  "textColor": {
                    "type": "string"
                  },
                  "descriptionColor": {
                    "type": "string"
                  },
                  "titleSize": {
                    "type": "number",
                    "minimum": 10,
                    "maximum": 72
                  },
                  "descriptionSize": {
                    "type": "number",
                    "minimum": 8,
                    "maximum": 48
                  },
                  "fontFamily": {
                    "type": "string",
                    "default": "Lato, \"Noto Sans\", \"DejaVu Sans\", sans-serif"
                  }
                }
              }
            }
          }
        },
        "drawing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands"
          ],
          "properties": {
            "fontFamily": {
              "type": "string",
              "default": "Lato, \"Noto Sans\", \"DejaVu Sans\", sans-serif"
            },
            "staggerMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2000,
              "default": 85
            },
            "commandDurationMs": {
              "type": "integer",
              "minimum": 180,
              "maximum": 5000,
              "default": 560
            },
            "layout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "manual",
                    "hybrid",
                    "auto"
                  ],
                  "default": "hybrid"
                },
                "padding": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.16,
                  "default": 0.035
                },
                "gap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.1,
                  "default": 0.022
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "avoidOverlap": {
                  "type": "boolean",
                  "default": true
                }
              }
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 120,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "type": "string",
                    "enum": [
                      "rect",
                      "roundRect",
                      "circle",
                      "ellipse",
                      "line",
                      "arrow",
                      "text"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "from": {
                    "$ref": "#/definitions/point"
                  },
                  "to": {
                    "$ref": "#/definitions/point"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "fill": {
                    "type": "string"
                  },
                  "stroke": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "strokeWidth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "radius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "headSize": {
                    "type": "number",
                    "minimum": 4,
                    "maximum": 100
                  },
                  "fontFamily": {
                    "type": "string",
                    "default": "Lato, \"Noto Sans\", \"DejaVu Sans\", sans-serif"
                  },
                  "fontWeight": {
                    "type": "string",
                    "enum": [
                      "400",
                      "500",
                      "600",
                      "700",
                      "800"
                    ],
                    "default": "700"
                  },
                  "fontSize": {
                    "type": "number",
                    "minimum": 8,
                    "maximum": 120
                  },
                  "minFontSize": {
                    "type": "number",
                    "minimum": 6,
                    "maximum": 80
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ]
                  },
                  "allowOverlap": {
                    "type": "boolean",
                    "default": false
